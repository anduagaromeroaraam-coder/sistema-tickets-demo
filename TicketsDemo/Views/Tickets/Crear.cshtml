@model Ticket
@{
    ViewData["Titulo"] = "Nuevo ticket";
}

<h1 class="h3 mb-3">Nuevo ticket</h1>

<form asp-action="Crear" method="post" class="bg-white p-4 rounded border">
    <div class="mb-3">
        <label asp-for="Titulo" class="form-label"></label>
        <input asp-for="Titulo" class="form-control">
        <span asp-validation-for="Titulo" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger small"></span>
    </div>
    <div class="row">
        <div class="col-sm-6 mb-3">
            <label asp-for="ReportadoPor" class="form-label"></label>
            <input asp-for="ReportadoPor" class="form-control">
            <span asp-validation-for="ReportadoPor" class="text-danger small"></span>
        </div>
        <div class="col-sm-6 mb-3">
            <label asp-for="Prioridad" class="form-label"></label>
            <select asp-for="Prioridad" class="form-select" asp-items="Html.GetEnumSelectList<PrioridadTicket>()"></select>
        </div>
    </div>
    <button class="btn btn-dark">Guardar</button>
    <a asp-action="Index" class="btn btn-link">Cancelar</a>
</form>
