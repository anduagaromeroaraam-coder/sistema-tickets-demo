<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Titulo"] · Tickets internos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar bg-dark navbar-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Tickets" asp-action="Index">Tickets internos</a>
            <a class="btn btn-light btn-sm" asp-controller="Tickets" asp-action="Crear">Nuevo ticket</a>
        </div>
    </nav>
    <main class="container pb-5">
        @if (TempData["Aviso"] is string aviso)
        {
            <div class="alert alert-success">@aviso</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
